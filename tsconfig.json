{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "types": [
      "@types/react",
      "@types/react-dom",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "./components/*"
      ]
    },
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "types/globals.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "pages/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "utils/**/*.js"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
